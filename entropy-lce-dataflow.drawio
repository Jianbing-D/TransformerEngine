    <!-- Math box bottom-right -->
    <mxCell id="math_box2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="1400" width="1510" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="math_t2" value="Key Formulas" style="text;html=1;align=center;fontSize=14;fontStyle=5;fontColor=#E65100;" vertex="1" parent="1">
      <mxGeometry x="650" y="1403" width="250" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="math_fwd2" value="&lt;div style='text-align:left;font-size:11px;'&gt;&lt;b&gt;Forward:&lt;/b&gt; entropy_b = sum(z*exp(z-max)) / sum(exp(z-max)) = E_p[z].  entropy = LSE - entropy_b = H(p).&lt;br&gt;Uses same online max-correction as _accu. Adds 1 FMA per element (z * exp, reuses existing exp).&lt;/div&gt;" style="text;html=1;fillColor=#FFF8E1;strokeColor=none;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="35" y="1430" width="700" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="math_bwd2" value="&lt;div style='text-align:left;font-size:11px;'&gt;&lt;b&gt;Backward:&lt;/b&gt; dH/dz_v = -softmax_v * (z_v - entropy_b).&lt;br&gt;d_logits = dlogprobs*(softmax - 1_hot) + d_entropy*(-softmax)*(z - entropy_b). Adds 2 FMAs per element.&lt;/div&gt;" style="text;html=1;fillColor=#FFF8E1;strokeColor=none;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="35" y="1475" width="700" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="math_perf2" value="&lt;div style='text-align:left;font-size:11px;'&gt;&lt;b&gt;Performance:&lt;/b&gt; Both kernels are GEMM-bound. Epilogue additions are negligible (&amp;lt;5% est.).&lt;br&gt;When return_entropy=False (default), existing code path is used: zero overhead, zero risk.&lt;/div&gt;" style="text;html=1;fillColor=#E8F5E9;strokeColor=none;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="800" y="1430" width="700" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="math_files2" value="&lt;div style='text-align:left;font-size:11px;'&gt;&lt;b&gt;New files (4):&lt;/b&gt; fwd_mainloop_entropy.py, bwd_partial_dlogits_entropy.py, linear_cross_entropy_entropy.py (triton), linear_cross_entropy_entropy_entry.py&lt;br&gt;&lt;b&gt;Modified (1):&lt;/b&gt; pytorch/linear_cross_entropy.py (torch interface dispatch only)&lt;/div&gt;" style="text;html=1;fillColor=#F3E5F5;strokeColor=none;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="800" y="1475" width="700" height="40" as="geometry"/>
    </mxCell>

